[Unit]
Description=CamillaDSP web GUI backend
Documentation=https://github.com/HEnquist/camillagui-backend
After=network.target

[Service]
Type=simple
User=pi
Group=audio
WorkingDirectory=/opt/camillagui-backend
ExecStart=/opt/camillagui-backend/camillagui_backend
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
