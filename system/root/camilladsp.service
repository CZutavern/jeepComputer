[Unit]
Description=CamillaDSP audio processor
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
User=pi
Group=audio
SupplementaryGroups=audio

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/1000

ExecStartPre=/bin/sh -c 'until [ -S /run/user/1000/pipewire-0 ]; do sleep 1; done'

ExecStart=/usr/local/bin/camilladsp -l info -a 0.0.0.0 -p 1234 -g-40 /home/pi/CamillaDSP/carplay_8ch_crossover.yml

Restart=no
RestartSec=3

[Install]
WantedBy=multi-user.target
